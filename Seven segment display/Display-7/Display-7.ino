void displaySeven() {
    digitalWrite(2, HIGH); // TOP RIGHT
    digitalWrite(3, HIGH); // TOP MIDDLE
    digitalWrite(4, LOW);  // TOP LEFT
    digitalWrite(5, LOW);  // TRUE MIDDLE
    digitalWrite(6, HIGH); // BOTTOM RIGHT
    digitalWrite(7, LOW);  // BOTTOM MIDDLE
    digitalWrite(8, LOW);  // BOTTOM LEFT
    digitalWrite(9, LOW);  // DECIMAL
}