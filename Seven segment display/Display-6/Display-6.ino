void displaySix() {
    digitalWrite(2, LOW);  // TOP RIGHT
    digitalWrite(3, HIGH); // TOP MIDDLE
    digitalWrite(4, HIGH); // TOP LEFT
    digitalWrite(5, HIGH); // TRUE MIDDLE
    digitalWrite(6, HIGH); // BOTTOM RIGHT
    digitalWrite(7, HIGH); // BOTTOM MIDDLE
    digitalWrite(8, HIGH); // BOTTOM LEFT
    digitalWrite(9, LOW);  // DECIMAL
}